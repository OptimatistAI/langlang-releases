# Copy to /etc/langlang-feed.env and adjust the paths.
LANGLANG_RELEASES_REPO=OptimatistAI/langlang-releases
LANGLANG_FEED_STATE_DIR=/var/lib/langlang-feed
LANGLANG_MACOS_FEED_DIR=/srv/optimatist.ai/langlang/macos
LANGLANG_WINDOWS_FEED_DIR=/srv/optimatist.ai/langlang/windows
LANGLANG_PUBLIC_KEYS_FILE=/usr/local/share/langlang-releases/config/public-keys.env

# Optional: raises GitHub API rate limits. The repository is public, so the
# puller works without a token.
# GITHUB_TOKEN=

# OpenSSL 3 is required for Ed25519 verification. Ubuntu 22.04+ uses it by
# default; on macOS with OpenSSL 1.1.1, point this at an openssl3 binary.
# OPENSSL=/opt/homebrew/opt/openssl@3/bin/openssl
